# Only needed for local development outside Docker.
# Inside the container this is generated automatically unless you set it.
DATABASE_URL="mysql://personalcrm:personalcrm@127.0.0.1:3306/personalcrm"
UPLOADS_DIR="./data/uploads"

# Public base URL of the app. Its https:// scheme is what puts the session
# cookie in secure mode; nothing else reads it.
APP_URL="http://localhost:3000"

# 32+ byte random string used to sign session cookies.
# Generated automatically into /config/secrets.json inside the container.
AUTH_SECRET="change-me-to-a-long-random-string"

# Set to "true" to prevent new users from registering after the first account.
DISABLE_SIGNUP="false"

TZ="America/New_York"

# Separate database used by the integration tests. They wipe it between runs,
# so it must never point at the database you actually use.
TEST_DATABASE_URL="mysql://personalcrm:personalcrm@127.0.0.1:3306/personalcrm_test"
