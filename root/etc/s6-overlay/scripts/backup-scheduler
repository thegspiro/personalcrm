#!/command/with-contenv bash
# Run backup-now once a day at BACKUP_TIME (container-local 24-hour time).
set -euo pipefail
BACKUP_TIME="${BACKUP_TIME:-02:00}"
[[ "${BACKUP_TIME}" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || {
    echo "[backup] ERROR: BACKUP_TIME must be HH:MM in 24-hour time" >&2
    exit 1
}

echo "[backup] scheduler ready: daily at ${BACKUP_TIME} ${TZ:-Etc/UTC}"
while true; do
    now="$(date +%s)"
    next="$(date -d "today ${BACKUP_TIME}" +%s)"
    (( next > now )) || next="$(date -d "tomorrow ${BACKUP_TIME}" +%s)"
    sleep "$((next - now))"
    if ! /etc/s6-overlay/scripts/backup-now; then
        echo "[backup] scheduled run failed; the scheduler will retry tomorrow" >&2
    fi
done
