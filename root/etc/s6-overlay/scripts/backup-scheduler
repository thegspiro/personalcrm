#!/command/with-contenv bash
# Run backup-now once a day at BACKUP_TIME (container-local 24-hour time).
set -euo pipefail
# Trimmed, because preflight validates the trimmed value and would otherwise
# pass a setting the scheduler then rejects on every start.
BACKUP_TIME="${BACKUP_TIME:-02:00}"
BACKUP_TIME="${BACKUP_TIME#"${BACKUP_TIME%%[![:space:]]*}"}"
BACKUP_TIME="${BACKUP_TIME%"${BACKUP_TIME##*[![:space:]]}"}"
[[ "${BACKUP_TIME}" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || {
    echo "[backup] ERROR: BACKUP_TIME must be HH:MM in 24-hour time" >&2
    exit 1
}

# A wall-clock time does not exist on every day of the year. Where the clocks
# spring forward, the skipped hour is simply absent: in America/New_York,
# `date -d "2027-03-14 02:00"` is an invalid date — and 02:00 is this setting's
# default, in one of the most common timezones. The substitution failed, set -e
# killed the scheduler, and s6 restarted it into the same failure until the
# calendar moved past the day, so that day's backup never ran and neither did
# anything else the service does.
#
# The run moves to the first hour that does exist instead, which is the moment
# the clock reappears. Autumn needs nothing: a repeated hour is still a valid
# one, and the first of the two is taken.
epoch_for() {
    local day="$1" hour minute try candidate epoch
    hour=$((10#${BACKUP_TIME%%:*}))
    minute=$((10#${BACKUP_TIME##*:}))
    for try in 0 1 2; do
        candidate="$(printf '%02d:%02d' $(( (hour + try) % 24 )) "${minute}")"
        if epoch="$(date -d "${day} ${candidate}" +%s 2>/dev/null)"; then
            printf '%s' "${epoch}"
            return 0
        fi
    done
    return 1
}

echo "[backup] scheduler ready: daily at ${BACKUP_TIME} ${TZ:-Etc/UTC}"
while true; do
    now="$(date +%s)"
    next=""
    if candidate="$(epoch_for today)"; then
        if (( candidate > now )); then
            next="${candidate}"
        fi
    fi
    if [[ -z "${next}" ]] && candidate="$(epoch_for tomorrow)"; then
        next="${candidate}"
    fi
    if [[ -z "${next}" ]]; then
        # Never exit: s6 would restart into the same arithmetic, and a backup
        # service that is down is the one thing worse than a late backup.
        echo "[backup] ERROR: ${BACKUP_TIME} resolves to no time today or tomorrow in ${TZ:-Etc/UTC}; retrying within the hour" >&2
        sleep 3600
        continue
    fi
    sleep "$((next - now))"
    if ! /etc/s6-overlay/scripts/backup-now; then
        echo "[backup] scheduled run failed; the scheduler will retry tomorrow" >&2
    fi
done
