#!/command/with-contenv bash
# Wait for MariaDB to accept connections, then make sure the app's database,
# user, and grants exist. Idempotent — safe on every boot.
set -euo pipefail
source /etc/s6-overlay/scripts/common.sh

if using_external_database; then
    echo "[init-db-ready] external database — skipping local provisioning"
    exit 0
fi

for _ in $(seq 1 "${DB_WAIT_SECONDS:-120}"); do
    if mariadb-admin ping --socket=/run/mysqld/mysqld.sock --silent >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

if ! mariadb-admin ping --socket=/run/mysqld/mysqld.sock --silent >/dev/null 2>&1; then
    echo "[init-db-ready] MariaDB did not come up in time — see /config/logs/mariadb-error.log" >&2
    exit 1
fi

DB_PASSWORD="$(read_secret dbPassword)"
mariadb --socket=/run/mysqld/mysqld.sock <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASSWORD}';
CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'localhost';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

echo "[init-db-ready] database '${DB_NAME}' ready"
